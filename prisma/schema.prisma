// UMADHVAYA Luxury Sarees - Comprehensive Prisma Schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
  OWNER
  MANAGER
  INVENTORY_MANAGER
  ORDER_MANAGER
  CONTENT_MANAGER
  SUPPORT_AGENT
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  CASH_ON_DELIVERY
  BANK_TRANSFER
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum InventoryTransactionType {
  RESTOCK
  ORDER_RESERVATION
  ORDER_FULFILLED
  ORDER_CANCELLED
  DAMAGE_ADJUSTMENT
  RETURN_RESTOCK
  MANUAL_CORRECTION
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKED_UP
  RECEIVED
  INSPECTED
  REFUNDED
}

// -------------------------------------------------------------
// USER & AUTHENTICATION
// -------------------------------------------------------------

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String
  phone             String?           @unique
  firstName         String
  lastName          String
  role              Role              @default(CUSTOMER)
  isActive          Boolean           @default(true)
  isEmailVerified   Boolean           @default(false)
  emailVerifyToken  String?
  resetPasswordToken String?
  resetPasswordExp  DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  customerProfile   CustomerProfile?
  cart              Cart?
  wishlist          Wishlist?
  orders            Order[]
  reviews           Review[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  couponUsages      CouponUsage[]

  @@index([email])
  @@index([role])
}

model CustomerProfile {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl       String?
  dateOfBirth     DateTime?
  gender          String?
  totalSpent      Decimal      @default(0.00) @db.Decimal(12, 2)
  ordersCount     Int          @default(0)
  isSubscribed    Boolean      @default(true)
  preferredFabric String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  addresses       Address[]
}

model Address {
  id                String           @id @default(uuid())
  customerProfileId String
  customerProfile   CustomerProfile  @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  fullName          String
  phone             String
  alternatePhone    String?
  streetAddress     String
  apartmentSuite    String?
  landmark          String?
  city              String
  state             String
  pincode           String
  country           String           @default("India")
  addressType       AddressType      @default(HOME)
  isDefaultShipping Boolean          @default(false)
  isDefaultBilling  Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  ordersShipping    Order[]          @relation("OrderShippingAddress")
  ordersBilling     Order[]          @relation("OrderBillingAddress")

  @@index([customerProfileId])
  @@index([pincode])
}

// -------------------------------------------------------------
// CATALOG & SAREE PRODUCTS
// -------------------------------------------------------------

model Category {
  id              String       @id @default(uuid())
  name            String       @unique
  slug            String       @unique
  description     String?
  imageUrl        String?
  bannerUrl       String?
  displayOrder    Int          @default(0)
  isActive        Boolean      @default(true)
  isFeatured      Boolean      @default(false)
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  products        Product[]
  coupons         Coupon[]     @relation("CategoryCoupons")

  @@index([slug])
}

model Collection {
  id              String       @id @default(uuid())
  name            String       @unique
  slug            String       @unique
  tagline         String?
  description     String?
  imageUrl        String?
  bannerUrl       String?
  displayOrder    Int          @default(0)
  isActive        Boolean      @default(true)
  isFeatured      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  products        Product[]

  @@index([slug])
}

model Product {
  id                  String          @id @default(uuid())
  sku                 String          @unique
  name                String
  slug                String          @unique
  description         String          @db.Text
  shortDescription    String?         @db.Text
  categoryId          String
  category            Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  collectionId        String?
  collection          Collection?     @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  brand               String          @default("UMADHVAYA")
  
  // Pricing
  price               Decimal         @db.Decimal(10, 2)
  mrp                 Decimal         @db.Decimal(10, 2)
  discountPercent     Decimal         @default(0.00) @db.Decimal(5, 2)
  taxRate             Decimal         @default(5.00) @db.Decimal(5, 2) // Standard 5% GST on silk/handloom sarees in India
  hsnCode             String?         @default("5007") // Silk Fabrics HSN Code

  // Status & Highlights
  status              ProductStatus   @default(ACTIVE)
  isFeatured          Boolean         @default(false)
  isBestSeller        Boolean         @default(false)
  isNewArrival        Boolean         @default(true)
  isSilkMarkCertified Boolean         @default(true)
  isHandloomCertified Boolean         @default(false)

  // Saree-Specific Attributes
  fabric              String          // e.g. Pure Kanchipuram Silk, Banarasi Katan Silk, Chanderi, Organza
  color               String          // Primary color: Crimson Red, Emerald Green, Royal Gold, Mustard Yellow
  colorHex            String?         // Optional hex code for color swatch display
  pattern             String          // Zari Brocade, Floral Jaal, Temple Border, Butta Work, Traditional Motif
  occasion            String          // Bridal / Wedding, Festive, Party Wear, Traditional Rituals, Reception
  workType            String          // Real Gold Zari, Pure Silver Zari, Resham Threadwork, Kadwa Weave, Hand Painted
  sareeLength         String          @default("5.5 meters")
  blouseIncluded      Boolean         @default(true)
  blouseLength        String          @default("0.8 meters (Unstitched)")
  blouseFabric        String?         // Matching Silk with Zari Border
  weightGrams         Int?            @default(750)
  careInstructions    String          @default("Dry Clean Only. Store wrapped in pure cotton or muslin fabric. Avoid perfume contact with zari.")
  origin              String          @default("Kanchipuram, Tamil Nadu, India")
  manufacturer        String          @default("UMADHVAYA Master Weavers")
  returnEligible      Boolean         @default(true)
  returnPeriodDays    Int             @default(7)

  // SEO & Social
  seoTitle            String?
  seoDescription      String?

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // Relationships
  images              ProductImage[]
  videos              ProductVideo[]
  inventory           Inventory?
  cartItems           CartItem[]
  wishlistItems       WishlistItem[]
  orderItems          OrderItem[]
  reviews             Review[]
  coupons             Coupon[]        @relation("ProductCoupons")

  @@index([slug])
  @@index([categoryId])
  @@index([collectionId])
  @@index([fabric])
  @@index([color])
  @@index([occasion])
  @@index([price])
}

model ProductImage {
  id              String       @id @default(uuid())
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  url             String
  altText         String?
  isPrimary       Boolean      @default(false)
  isHover         Boolean      @default(false)
  displayOrder    Int          @default(0)
  createdAt       DateTime     @default(now())

  @@index([productId])
}

model ProductVideo {
  id              String       @id @default(uuid())
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  videoUrl        String
  thumbnailUrl    String?
  title           String?
  displayOrder    Int          @default(0)
  createdAt       DateTime     @default(now())

  @@index([productId])
}

// -------------------------------------------------------------
// INVENTORY MANAGEMENT
// -------------------------------------------------------------

model Inventory {
  id                  String                @id @default(uuid())
  productId           String                @unique
  product             Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockQuantity       Int                   @default(0)
  reservedQuantity    Int                   @default(0)
  availableQuantity   Int                   @default(0) // stockQuantity - reservedQuantity
  lowStockThreshold   Int                   @default(3)
  warehouseLocation   String?               @default("Chennai Main Vault")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  transactions        InventoryTransaction[]
}

model InventoryTransaction {
  id              String                   @id @default(uuid())
  inventoryId     String
  inventory       Inventory                @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type            InventoryTransactionType
  quantityChange  Int                      // Positive or negative
  previousStock   Int
  newStock        Int
  referenceId     String?                  // OrderId, RestockInvoiceId, etc.
  notes           String?
  performedBy     String?                  // Admin / System / Staff User ID
  createdAt       DateTime                 @default(now())

  @@index([inventoryId])
  @@index([type])
}

// -------------------------------------------------------------
// CART & WISHLIST
// -------------------------------------------------------------

model Cart {
  id              String       @id @default(uuid())
  userId          String?      @unique
  user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSessionId  String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items           CartItem[]

  @@index([userId])
  @@index([guestSessionId])
}

model CartItem {
  id              String       @id @default(uuid())
  cartId          String
  cart            Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Int          @default(1)
  blouseCustomization String?  // Optional unstitched / stitched / standard note
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
}

model Wishlist {
  id              String         @id @default(uuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items           WishlistItem[]
}

model WishlistItem {
  id              String       @id @default(uuid())
  wishlistId      String
  wishlist        Wishlist     @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())

  @@unique([wishlistId, productId])
  @@index([wishlistId])
}

// -------------------------------------------------------------
// ORDERS & CHECKOUT
// -------------------------------------------------------------

model Order {
  id                  String             @id @default(uuid())
  orderNumber         String             @unique // e.g. UMD-2026-1008
  userId              String?
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestEmail          String?
  guestPhone          String?

  status              OrderStatus        @default(PENDING_PAYMENT)
  
  // Amounts
  itemsSubtotal       Decimal            @db.Decimal(10, 2)
  discountAmount      Decimal            @default(0.00) @db.Decimal(10, 2)
  taxAmount           Decimal            @default(0.00) @db.Decimal(10, 2)
  shippingFee         Decimal            @default(0.00) @db.Decimal(10, 2)
  totalAmount         Decimal            @db.Decimal(10, 2)

  // Applied Coupon
  couponId            String?
  couponCode          String?

  // Addresses Snapshot
  shippingAddressId   String?
  shippingAddress     Address?           @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  shippingSnapshot    Json?              // In case address is deleted later

  billingAddressId    String?
  billingAddress      Address?           @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  billingSnapshot     Json?

  customerNotes       String?
  internalAdminNotes  String?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Relations
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  payments            Payment[]
  shipments           Shipment[]
  returns             Return[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
}

model OrderItem {
  id              String       @id @default(uuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName     String       // Snapshot
  productSku      String       // Snapshot
  productImageUrl String?      // Snapshot
  sareeFabric     String?      // Snapshot
  unitPrice       Decimal      @db.Decimal(10, 2)
  quantity        Int          @default(1)
  totalPrice      Decimal      @db.Decimal(10, 2)
  hsnCode         String?
  taxAmount       Decimal      @default(0.00) @db.Decimal(10, 2)
  createdAt       DateTime     @default(now())

  returnItems     ReturnItem[]

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id              String       @id @default(uuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          OrderStatus
  notes           String?
  performedBy     String?      // User ID or 'SYSTEM'
  createdAt       DateTime     @default(now())

  @@index([orderId])
}

// -------------------------------------------------------------
// PAYMENTS & REFUNDS
// -------------------------------------------------------------

model Payment {
  id                  String           @id @default(uuid())
  orderId             String
  order               Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentProvider     PaymentProvider  @default(RAZORPAY)
  providerOrderId     String?          // Razorpay order_id
  providerPaymentId   String?          // Razorpay payment_id
  providerSignature   String?          // Razorpay signature
  amount              Decimal          @db.Decimal(10, 2)
  currency            String           @default("INR")
  status              PaymentStatus    @default(PENDING)
  rawResponse         Json?
  failureReason       String?
  paidAt              DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  refunds             Refund[]

  @@index([orderId])
  @@index([providerOrderId])
}

model Refund {
  id                  String       @id @default(uuid())
  paymentId           String
  payment             Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount              Decimal      @db.Decimal(10, 2)
  reason              String?
  providerRefundId    String?      // Razorpay refund_id
  status              String       @default("PROCESSED")
  processedBy         String?      // Admin User ID
  createdAt           DateTime     @default(now())

  @@index([paymentId])
}

// -------------------------------------------------------------
// SHIPMENT & RETURNS
// -------------------------------------------------------------

model Shipment {
  id                  String       @id @default(uuid())
  orderId             String
  order               Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierPartner      String       // BlueDart, Delhivery, DTDC, IndiaPost
  trackingNumber      String       @unique
  trackingUrl         String?
  shippedAt           DateTime?
  estimatedDelivery   DateTime?
  deliveredAt         DateTime?
  status              String       @default("IN_TRANSIT")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([orderId])
  @@index([trackingNumber])
}

model Return {
  id                  String       @id @default(uuid())
  orderId             String
  order               Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnNumber        String       @unique // e.g. RET-2026-004
  status              ReturnStatus @default(REQUESTED)
  reason              String
  adminNotes          String?
  pickupTrackingNo    String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  returnItems         ReturnItem[]

  @@index([orderId])
}

model ReturnItem {
  id                  String       @id @default(uuid())
  returnId            String
  return              Return       @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId         String
  orderItem           OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity            Int          @default(1)
  conditionReport     String?

  @@index([returnId])
}

// -------------------------------------------------------------
// COUPONS & OFFERS
// -------------------------------------------------------------

model Coupon {
  id                  String          @id @default(uuid())
  code                String          @unique
  title               String
  description         String?
  discountType        DiscountType    @default(PERCENTAGE)
  discountValue       Decimal         @db.Decimal(10, 2) // 10% or ₹1000
  minOrderAmount      Decimal?        @db.Decimal(10, 2)
  maxDiscountAmount   Decimal?        @db.Decimal(10, 2)
  startDate           DateTime        @default(now())
  endDate             DateTime
  usageLimitTotal     Int?            @default(500)
  usageLimitPerUser   Int             @default(1)
  timesUsed           Int             @default(0)
  isActive            Boolean         @default(true)
  firstOrderOnly      Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  applicableCategories Category[]     @relation("CategoryCoupons")
  applicableProducts   Product[]      @relation("ProductCoupons")
  usages               CouponUsage[]

  @@index([code])
}

model CouponUsage {
  id                  String       @id @default(uuid())
  couponId            String
  coupon              Coupon       @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId             String
  discountApplied     Decimal      @db.Decimal(10, 2)
  usedAt              DateTime     @default(now())

  @@index([couponId])
  @@index([userId])
}

// -------------------------------------------------------------
// REVIEWS & RATINGS
// -------------------------------------------------------------

model Review {
  id                  String        @id @default(uuid())
  productId           String
  product             Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating              Int           // 1 to 5
  title               String?
  comment             String        @db.Text
  isVerifiedPurchase  Boolean       @default(false)
  isApproved          Boolean       @default(true) // Auto-approve or moderation
  helpfulCount        Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  images              ReviewImage[]

  @@index([productId])
  @@index([userId])
}

model ReviewImage {
  id                  String       @id @default(uuid())
  reviewId            String
  review              Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  imageUrl            String
  createdAt           DateTime     @default(now())

  @@index([reviewId])
}

// -------------------------------------------------------------
// CMS (BANNERS, BLOG, NOTIFICATIONS)
// -------------------------------------------------------------

model Banner {
  id                  String       @id @default(uuid())
  title               String
  subtitle            String?
  badgeText           String?      // e.g. "Royal Heritage Collection"
  linkUrl             String?      // e.g. "/shop/kanchipuram-silk"
  imageUrlDesktop     String
  imageUrlMobile      String?
  position            String       @default("HERO_SLIDER") // HERO_SLIDER, PROMO_GRID, WEDDING_FEATURE, FESTIVE_STRIP
  displayOrder        Int          @default(0)
  isActive            Boolean      @default(true)
  startDate           DateTime?
  endDate             DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([position])
}

model BlogPost {
  id                  String       @id @default(uuid())
  title               String
  slug                String       @unique
  excerpt             String       @db.Text
  content             String       @db.Text
  coverImageUrl       String?
  authorName          String       @default("UMADHVAYA Heritage Curators")
  publishedAt         DateTime     @default(now())
  isPublished         Boolean      @default(true)
  readTimeMinutes     Int          @default(4)
  tags                String[]     @default(["Saree Guide", "Heritage Weaves", "Silk Care"])
  seoTitle            String?
  seoDescription      String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([slug])
}

model Notification {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  message             String       @db.Text
  type                String       @default("ORDER_UPDATE") // ORDER_UPDATE, PROMO, PRICE_DROP, SYSTEM
  linkUrl             String?
  isRead              Boolean      @default(false)
  createdAt           DateTime     @default(now())

  @@index([userId])
}

// -------------------------------------------------------------
// AUDIT LOGGING
// -------------------------------------------------------------

model AuditLog {
  id                  String       @id @default(uuid())
  userId              String?
  user                User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action              String       // e.g. "PRODUCT_CREATE", "ORDER_STATUS_UPDATE", "STOCK_ADJUSTMENT"
  entityType          String       // "Product", "Order", "User", "Coupon"
  entityId            String?
  oldValue            Json?
  newValue            Json?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime     @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}
