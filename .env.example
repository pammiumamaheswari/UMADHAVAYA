# ==========================================
# UMADHVAYA SAREE PLATFORM ENVIRONMENT CONFIG
# ==========================================

# Application Port & Mode
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME=UMADHVAYA
FRONTEND_STOREFRONT_URL=http://localhost:5173
ADMIN_PORTAL_URL=http://localhost:5174

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/umadhvaya_saree_db?schema=public

# Redis Connection (Caching & Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Token Expiration
JWT_ACCESS_SECRET=umadhvaya_jwt_access_secret_super_secure_key_2026_heritage
JWT_REFRESH_SECRET=umadhvaya_jwt_refresh_secret_super_secure_key_2026_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateway (Razorpay India)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# Media Storage (Cloudinary or AWS S3)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=umadhvaya-assets

# Email Notifications (SMTP / Resend / SendGrid)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=support@umadhvaya.com

# Cors Settings
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
